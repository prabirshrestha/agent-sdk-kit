{
  "name": "agent-sdk-kit",
  "version": "0.0.1",
  "description": "Agent kit library",
  "keywords": [],
  "homepage": "https://github.com/prabirshrestha/agent-kit",
  "bugs": {
    "url": "https://github.com/prabirshrestha/agent-kit/issues"
  },
  "license": "MIT",
  "author": "Prabir Shrestha <mail@prabir.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/prabirshrestha/agent-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun run --parallel format:check lint typecheck && bun run build && bun run test",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test --shuffle --concurrency",
    "publint": "publint",
    "attw": "attw --pack",
    "prepublishOnly": "bun run build && bun run publint && bun run attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/bun": "^1.3.12",
    "@typescript/native-preview": "^7.0.0-dev.20260419.1",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.9"
  }
}
