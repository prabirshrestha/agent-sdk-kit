{
  "name": "agent-sdk-kit",
  "version": "0.0.5",
  "description": "Wrap multiple coding-agent CLIs (claude, copilot, opencode, pi) behind a uniform API with native session resume and fork.",
  "keywords": [
    "acp",
    "agent",
    "ai",
    "claude",
    "copilot",
    "llm",
    "opencode",
    "sdk",
    "toolkit"
  ],
  "homepage": "https://github.com/prabirshrestha/agent-sdk-kit",
  "bugs": {
    "url": "https://github.com/prabirshrestha/agent-sdk-kit/issues"
  },
  "license": "MIT",
  "author": "Prabir Shrestha <mail@prabir.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prabirshrestha/agent-sdk-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun run --parallel format:check lint typecheck && bun run build && bun run test",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "publint": "publint",
    "attw": "attw --pack",
    "prepublishOnly": "bun run build && bun run publint && bun run attw"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@github/copilot-sdk": "^1.0.0-beta.1",
    "@opencode-ai/sdk": "^1.14.35",
    "@types/bun": "^1.3.13",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.10"
  },
  "peerDependencies": {
    "@github/copilot-sdk": "^1.0.0-beta.1",
    "@opencode-ai/sdk": "^1.4.12",
    "@zed-industries/agent-client-protocol": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    },
    "@zed-industries/agent-client-protocol": {
      "optional": true
    }
  }
}
